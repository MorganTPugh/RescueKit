# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Which Gemini model generates bios. Optional — defaults to
# "gemini-flash-latest" (an alias Google keeps pointed at their current
# flash model, so it won't silently break when a dated model like
# "gemini-2.0-flash" is retired). Override here if you want to pin a
# specific version instead, e.g. "gemini-3.6-flash".
GEMINI_MODEL="gemini-flash-latest"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP settings for the Send Feedback form (optional but required for email delivery).
# Use Gmail App Password: https://myaccount.google.com/apppasswords
# Set SMTP_USER to the Gmail address and SMTP_PASS to the 16-char App Password.
# SMTP_FROM defaults to SMTP_USER if not set.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="your-gmail@gmail.com"
